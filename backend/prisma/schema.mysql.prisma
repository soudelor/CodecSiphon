// MySQL — keep in sync with schema.postgresql.prisma.
// CodecSiphon — aligned with docs/DATABASE_DESIGN.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum TaskStatus {
  pending
  queued
  parsing
  downloading
  processing
  completed
  paused
  cancelled
  failed
}

enum TaskSourceType {
  single_url
  multi_url
  playlist
  subscription
}

enum SubscriptionType {
  channel
  playlist
  rss
}

enum SubscriptionStatus {
  active
  paused
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  displayName       String?   @map("display_name") @db.VarChar(100)
  role              UserRole  @default(user)
  storageQuotaBytes BigInt    @default(107374182400) @map("storage_quota_bytes")
  storageUsedBytes  BigInt    @default(0) @map("storage_used_bytes")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  refreshTokens RefreshToken[]
  userSettings  UserSettings?
  folders       Folder[]
  downloadTasks DownloadTask[]
  subscriptions Subscription[]
  mediaFiles    MediaFile[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserSettings {
  userId           String   @id @map("user_id")
  preferences      Json     @default("{}")
  downloadDefaults Json     @default("{}") @map("download_defaults")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model GlobalSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("global_settings")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  name      String   @db.VarChar(255)
  path      String
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[]   @relation("FolderHierarchy")
  files    MediaFile[]

  @@unique([userId, path])
  @@index([userId])
  @@map("folders")
}

model Subscription {
  id                  String             @id @default(uuid())
  userId              String             @map("user_id")
  type                SubscriptionType
  sourceUrl           String             @map("source_url")
  displayName         String?            @map("display_name") @db.VarChar(255)
  status              SubscriptionStatus @default(active)
  checkIntervalSec    Int                @default(21600) @map("check_interval_sec")
  downloadOptions     Json               @default("{}") @map("download_options")
  filterRules         Json               @default("{}") @map("filter_rules")
  notifyEmail         Boolean            @default(false) @map("notify_email")
  notifyDesktop       Boolean            @default(false) @map("notify_desktop")
  lastCheckedAt       DateTime?          @map("last_checked_at") @db.DateTime(3)
  lastItemPublishedAt DateTime?          @map("last_item_published_at") @db.DateTime(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        SubscriptionRun[]
  spawnTasks  DownloadTask[]

  @@index([userId, status])
  @@map("subscriptions")
}

model SubscriptionRun {
  id               BigInt    @id @default(autoincrement())
  subscriptionId   String    @map("subscription_id")
  startedAt        DateTime  @default(now()) @map("started_at") @db.DateTime(3)
  finishedAt       DateTime? @map("finished_at") @db.DateTime(3)
  newTasksCreated  Int       @default(0) @map("new_tasks_created")
  errorMessage     String?   @map("error_message")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, id(sort: Desc)])
  @@map("subscription_runs")
}

model DownloadTask {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  subscriptionId    String?        @map("subscription_id")
  sourceType        TaskSourceType @map("source_type")
  status            TaskStatus     @default(pending)
  sourceUrl         String?        @map("source_url")
  sourceUrls        Json           @default("[]") @map("source_urls")
  title             String?
  platform          String?        @db.VarChar(64)
  options           Json           @default("{}")
  progressPercent   Int            @default(0) @map("progress_percent") @db.SmallInt
  bytesDownloaded   BigInt         @default(0) @map("bytes_downloaded")
  bytesTotal        BigInt?        @map("bytes_total")
  speedBytesPerSec  Int?           @map("speed_bytes_per_sec")
  errorCode         String?        @map("error_code") @db.VarChar(64)
  errorMessage      String?        @map("error_message")
  scheduledAt       DateTime?      @map("scheduled_at") @db.DateTime(3)
  startedAt         DateTime?      @map("started_at") @db.DateTime(3)
  completedAt       DateTime?      @map("completed_at") @db.DateTime(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items        TaskItem[]
  logs         TaskLog[]
  mediaFiles   MediaFile[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("download_tasks")
}

model TaskItem {
  id               String     @id @default(uuid())
  taskId           String     @map("task_id")
  itemIndex        Int        @map("item_index")
  canonicalId      String?    @map("canonical_id") @db.VarChar(128)
  itemUrl          String     @map("item_url")
  title            String?
  status           TaskStatus @default(pending)
  progressPercent  Int        @default(0) @map("progress_percent") @db.SmallInt
  mediaFileId      String?    @map("media_file_id")
  errorMessage     String?    @map("error_message")
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  task      DownloadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mediaFile MediaFile?   @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)

  @@unique([taskId, itemIndex])
  @@index([taskId])
  @@map("task_items")
}

model TaskLog {
  id        BigInt   @id @default(autoincrement())
  taskId    String   @map("task_id")
  level     String   @db.VarChar(16)
  message   String
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  task DownloadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, id(sort: Desc)])
  @@map("task_logs")
}

model MediaFile {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  taskId         String?  @map("task_id")
  folderId       String?  @map("folder_id")
  fileName       String   @map("file_name") @db.VarChar(512)
  relativePath   String   @map("relative_path")
  mimeType       String?  @map("mime_type") @db.VarChar(128)
  sizeBytes      BigInt   @map("size_bytes")
  durationSec    Int?     @map("duration_sec")
  width          Int?
  height         Int?
  checksumSha256 String?  @map("checksum_sha256") @db.VarChar(64)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      DownloadTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  folder    Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  taskItems TaskItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, fileName])
  @@map("media_files")
}

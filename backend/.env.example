# PostgreSQL connection (used by Prisma Migrate and Nest at runtime)
DATABASE_URL="postgresql://codec_siphon:codec_siphon@localhost:5432/codec_siphon?schema=public"

# HTTP
PORT=3000

# JWT (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_DAYS=7

# CORS：前端开发地址，逗号分隔
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# BullMQ / Redis（下载队列入队必需）
REDIS_URL=redis://127.0.0.1:6379

# 本地下载根目录（相对进程 cwd 或绝对路径）
DOWNLOAD_ROOT=./data/downloads

# yt-dlp 可执行文件名或绝对路径；Windows 未在 PATH 时可设 yt-dlp.exe 的完整路径
YTDLP_PATH=yt-dlp

# 「多条链接」批量任务允许的最大 URL 条数（正整数，默认 5，上限 500）
MULTI_URL_MAX_LINKS=5

# B 站等站点若出现 HTTP 412：建议使用浏览器导出 Cookie 或从浏览器读取（需本机安装对应浏览器）
# YTDLP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/131.0.0.0 ...
# YTDLP_REFERER=https://www.bilibili.com/
# YTDLP_COOKIES_FILE=C:/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

# 数据库：仅支持 MySQL（`npm run prisma:migrate` 使用 prisma/migrations 下 MySQL SQL）
DATABASE_URL="mysql://codec_siphon:codec_siphon@localhost:3306/codec_siphon"

# HTTP（部署时默认监听 0.0.0.0；仅本机可设 HOST=127.0.0.1）
PORT=3000
# HOST=0.0.0.0

# JWT (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_DAYS=7

# 新用户注册时的缺省配额（字节）；仅写入新用户记录，不改历史用户存量
# 1 GiB = 1073741824；5 GiB = 5368709120（自然月出站下载配额上限；用量统计与限流待迭代）
DEFAULT_USER_STORAGE_QUOTA_BYTES=1073741824
DEFAULT_USER_MONTHLY_DOWNLOAD_QUOTA_BYTES=5368709120

# 存储：`src/storage-policy/` 注册入库任务入队前策略（当前默认硬拒绝——已用量≥存储配额则不可新建会持续占库的下载任务）。后续可用 env 切换策略集合。
# STORAGE_QUOTA_POLICY=...  # reserved

# CORS：前端开发地址，逗号分隔
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 重置密码邮件中的前端地址（不设则默认取 FRONTEND_ORIGIN 逗号第一项，再退回 localhost:5173）
# PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
# PASSWORD_RESET_EXPIRES_MINUTES=30

# SMTP（不设 SMTP_HOST 时跳过发信，控制台会打 WARN，便于本地开发）
# 163 邮箱常用：SMTP_HOST=smtp.163.com，端口 465（SSL）或 587（STARTTLS，设 SMTP_SECURE=false）
# 若日志出现 queryA ETIMEOUT：465 端口可设 SMTP_DNS_IPV4_ONLY=true（587/STARTTLS 请保持 false，直连域名）
# SMTP_HOST=smtp.163.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_account@163.com
# SMTP_PASS=your_smtp_client_auth_code
# MAIL_FROM="CodecSiphon <your_account@163.com>"
# MAIL_APP_NAME=CodecSiphon
# SMTP_DNS_IPV4_ONLY=true
# SMTP_TLS_SERVERNAME=smtp.163.com
# SMTP_CONNECTION_TIMEOUT_MS=45000
# SMTP_DEBUG=1
# SMTP_EHLO_HOSTNAME=localhost

# 忘记密码接口限频（Forgot-password，依赖 Redis）
# FORGOT_PASSWORD_RATE_WINDOW_SEC=3600
# FORGOT_PASSWORD_IP_LIMIT=30
# FORGOT_PASSWORD_EMAIL_LIMIT=8

# 注册邮箱验证码（依赖 SMTP + Redis 限频；未配置 SMTP 时 POST /auth/send-registration-code 返回 503）
# REGISTRATION_OTP_EXPIRES_MINUTES=15
# REGISTRATION_OTP_VERIFY_MAX_ATTEMPTS=10
# REGISTRATION_CODE_RATE_WINDOW_SEC=3600
# REGISTRATION_CODE_IP_LIMIT=60
# REGISTRATION_CODE_EMAIL_LIMIT=12

# BullMQ / Redis（下载队列入队必需；防重放同样依赖此连接）
REDIS_URL=redis://127.0.0.1:6379

# 防重放：客户端 X-Client-Timestamp 与服务器允许偏差（毫秒，默认 300000）
# REPLAY_WINDOW_MS=300000

# 反向代理后需要真实客户端 IP 时设为 1（见 main.ts trust proxy）
# TRUST_PROXY=1

# 本地下载根目录（相对进程 cwd 或绝对路径）
DOWNLOAD_ROOT=./data/downloads

# yt-dlp 可执行文件名或绝对路径；Windows 未在 PATH 时可设 yt-dlp.exe 的完整路径
YTDLP_PATH=yt-dlp

# 「多条链接」批量任务允许的最大 URL 条数（正整数，默认 5，上限 500）
MULTI_URL_MAX_LINKS=5

# 链接解析 /url-extract：登录用户单次返回条数上限（默认 100，硬上限 500）
# URL_EXTRACT_MAX_ITEMS=100
# 公开预览页每条目数（默认 3，上限 50）
# URL_EXTRACT_PUBLIC_PREVIEW=3
# 公开接口每 IP 滑动窗口内最大请求数（默认 20）；窗口时长见 URL_EXTRACT_PUBLIC_RATE_WINDOW_MS
# URL_EXTRACT_PUBLIC_RATE_LIMIT=20
# 滑动窗口毫秒数（默认 900000 = 15 分钟，最小 60000）
# URL_EXTRACT_PUBLIC_RATE_WINDOW_MS=900000
# 登录版「节选下载」截取时长（秒，默认 30，允许 5–120；需本机 PATH 含 ffmpeg）
# URL_EXTRACT_SAMPLE_MAX_SEC=30

# B 站等若 HTTP 412：须在已登录 bilibili 的浏览器导出 Netscape 格式 cookies.txt，上传到服务器并设绝对路径（无桌面/无 Chrome 用户数据时不要使用 COOKIES_FROM_BROWSER）
# YTDLP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/131.0.0.0 ...
# YTDLP_REFERER=https://www.bilibili.com/
# YTDLP_COOKIES_FILE=/var/lib/codec-siphon/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

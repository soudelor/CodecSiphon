# 复制为同一目录下的 `.env` 后执行 `docker compose up`（勿提交真实密钥）

# 数据库：仅 MySQL（与 backend/.env 一致）

# —— API 容器运行时（必填）——
DATABASE_URL=mysql://USER:PASSWORD@db.example.com:3306/codec_siphon_db
REDIS_URL=redis://:PASSWORD@redis.example.com:6379
JWT_SECRET=replace-with-a-long-random-secret

# 浏览器里打开前端的 Origin（CORS），多个用英文逗号
FRONTEND_ORIGIN=https://app.example.com

# 构建前端时写入（浏览器请求 API 的根地址，无尾斜杠，需公网可访问）
VITE_API_URL=https://api.example.com

# 监听端口（主机 : 容器）
PORT=3000
API_PORT=3000
WEB_PORT=8080

# 经反向代理时可设 1（见 backend main.ts）
# TRUST_PROXY=1

# 不在容器启动时执行 prisma migrate（例如 MySQL 首库用 db push、或迁移由他处执行）
# SKIP_PRISMA_MIGRATE=1
